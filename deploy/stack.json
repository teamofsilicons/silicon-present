{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Silicon Present: Ubuntu 24.04 ARM64, one API, Next.js, private converter, PostgreSQL and direct HTTPS.",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "SubnetId": {
      "Type": "AWS::EC2::Subnet::Id",
      "Description": "A public subnet with a route to an Internet Gateway."
    },
    "AppSecretArn": {
      "Type": "String",
      "AllowedPattern": "arn:[a-z0-9-]+:secretsmanager:[a-z0-9-]+:[0-9]{12}:secret:.+",
      "Description": "The Present runtime secret; no secret value belongs in stack parameters."
    },
    "AmiId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/canonical/ubuntu/server/24.04/stable/current/arm64/hvm/ebs-gp3/ami-id"
    },
    "InstanceType": {
      "Type": "String",
      "Default": "t4g.medium",
      "AllowedValues": [
        "t4g.medium",
        "t4g.large"
      ]
    }
  },
  "Resources": {
    "Backups": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "ExpireBackups",
              "Prefix": "backups/",
              "Status": "Enabled",
              "ExpirationInDays": 30,
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 30
              },
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 7
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Service",
            "Value": "silicon-present"
          },
          {
            "Key": "Environment",
            "Value": "production"
          }
        ]
      }
    },
    "BackupPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "Backups"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Backups",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${Backups.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "SecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Present HTTP/HTTPS only; administration through SSM",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "silicon-present-production"
          },
          {
            "Key": "Service",
            "Value": "silicon-present"
          },
          {
            "Key": "Environment",
            "Value": "production"
          }
        ]
      }
    },
    "Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore"
          }
        ],
        "Policies": [
          {
            "PolicyName": "PresentRuntimeOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": {
                    "Ref": "AppSecretArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Backups.Arn}/releases/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject",
                    "s3:AbortMultipartUpload"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Backups.Arn}/backups/*"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Service",
            "Value": "silicon-present"
          },
          {
            "Key": "Environment",
            "Value": "production"
          }
        ]
      }
    },
    "Profile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "Role"
          }
        ]
      }
    },
    "Instance": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "AmiId"
        },
        "InstanceType": {
          "Ref": "InstanceType"
        },
        "IamInstanceProfile": {
          "Ref": "Profile"
        },
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "AssociatePublicIpAddress": true,
            "SubnetId": {
              "Ref": "SubnetId"
            },
            "GroupSet": [
              {
                "Ref": "SecurityGroup"
              }
            ]
          }
        ],
        "MetadataOptions": {
          "HttpEndpoint": "enabled",
          "HttpTokens": "required",
          "HttpPutResponseHopLimit": 1,
          "InstanceMetadataTags": "disabled"
        },
        "CreditSpecification": {
          "CPUCredits": "standard"
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/sda1",
            "Ebs": {
              "VolumeType": "gp3",
              "VolumeSize": 60,
              "Encrypted": true,
              "DeleteOnTermination": false
            }
          }
        ],
        "UserData": {
          "Fn::Base64": "#!/bin/bash\n# First-boot dependencies only. Runtime secrets and releases belong to install.py.\nset -euo pipefail\numask 077\nexport DEBIAN_FRONTEND=noninteractive\n\nif [ \"$(id -u)\" -ne 0 ]; then\n  echo 'Run the Present host bootstrap as root.' >&2\n  exit 1\nfi\n. /etc/os-release\nif [ \"$ID\" != ubuntu ] || [ \"$VERSION_ID\" != 24.04 ] || [ \"$(dpkg --print-architecture)\" != arm64 ]; then\n  echo 'This bootstrap requires Ubuntu 24.04 ARM64.' >&2\n  exit 1\nfi\n\napt-get -o DPkg::Lock::Timeout=300 update\napt-get -o DPkg::Lock::Timeout=300 install -y --no-install-recommends \\\n  ca-certificates curl software-properties-common snapd\nadd-apt-repository --yes universe\napt-get -o DPkg::Lock::Timeout=300 update\napt-get -o DPkg::Lock::Timeout=300 install -y --no-install-recommends \\\n  python3 python3-venv build-essential pkg-config libssl-dev \\\n  postgresql-16 postgresql-client-16 \\\n  libreoffice-impress-nogui libreoffice-draw-nogui poppler-utils ffmpeg \\\n  fonts-dejavu-core fonts-liberation fonts-noto-core fonts-noto-color-emoji \\\n  fontconfig unzip xz-utils tar gzip bubblewrap \\\n  libasound2t64 libatk1.0-0t64 libatk-bridge2.0-0t64 libcups2t64 \\\n  libnss3 libnspr4 libdbus-1-3 libdrm2 libx11-6 libxcb1 libxcomposite1 \\\n  libxdamage1 libxext6 libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 libcairo2\n\n# Ubuntu cloud images ship the snap agent. Install it if the selected image does not.\nsystemctl enable --now snapd.socket\ntimeout 300 snap wait system seed.loaded\nif ! snap list amazon-ssm-agent >/dev/null 2>&1; then\n  snap install amazon-ssm-agent --classic\nfi\nsystemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent.service\nif ! snap list aws-cli >/dev/null 2>&1; then\n  snap install aws-cli --classic\nfi\n# systemd/SSM commands may not include /snap/bin in PATH.\nif [ ! -e /usr/local/bin/aws ]; then\n  cat > /usr/local/bin/aws <<'AWS_WRAPPER'\n#!/bin/sh\nexec /snap/bin/aws \"$@\"\nAWS_WRAPPER\n  chmod 0755 /usr/local/bin/aws\nfi\n/usr/local/bin/aws --version\nsystemctl enable --now postgresql\n\ninstall -d -m 0755 /opt/present /opt/present/releases /var/lib/present\ninstall -d -m 0700 /etc/present /var/backups/present\nfc-cache -f\ndate -u +%FT%TZ > /opt/present/bootstrap-complete\necho 'Present host dependencies are ready; install a verified release next.'\n"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "silicon-present-production"
          },
          {
            "Key": "Service",
            "Value": "silicon-present"
          },
          {
            "Key": "Environment",
            "Value": "production"
          }
        ]
      }
    },
    "Address": {
      "Type": "AWS::EC2::EIP",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Domain": "vpc",
        "Tags": [
          {
            "Key": "Name",
            "Value": "silicon-present-production"
          },
          {
            "Key": "Service",
            "Value": "silicon-present"
          },
          {
            "Key": "Environment",
            "Value": "production"
          }
        ]
      }
    },
    "AddressAssociation": {
      "Type": "AWS::EC2::EIPAssociation",
      "Properties": {
        "InstanceId": {
          "Ref": "Instance"
        },
        "AllocationId": {
          "Fn::GetAtt": [
            "Address",
            "AllocationId"
          ]
        }
      }
    }
  },
  "Outputs": {
    "InstanceId": {
      "Value": {
        "Ref": "Instance"
      }
    },
    "PublicIp": {
      "Value": {
        "Ref": "Address"
      }
    },
    "ElasticIpAllocationId": {
      "Value": {
        "Fn::GetAtt": [
          "Address",
          "AllocationId"
        ]
      }
    },
    "BackupBucket": {
      "Value": {
        "Ref": "Backups"
      }
    },
    "SecurityGroupId": {
      "Value": {
        "Ref": "SecurityGroup"
      }
    },
    "WebUrl": {
      "Value": "https://present.teamofsilicons.com"
    },
    "ApiUrl": {
      "Value": "https://backend.present.teamofsilicons.com"
    },
    "ResolvedAmiId": {
      "Value": {
        "Ref": "AmiId"
      }
    }
  }
}
